# --- the TILT contract. Leave empty until it is deployed: the site then stays
# in its pre-launch state (rules, assets, reference prices; staking disabled).
NEXT_PUBLIC_TILT_ADDRESS=

# --- chain (defaults are Robinhood Chain mainnet; only change for a local node)
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_PYTH_ADDRESS=0x8250f4aF4B972684F7b336503E2D6dFeDeB1487a

# --- Pyth Hermes (server-side only, never NEXT_PUBLIC_). Hermes has needed a
# key since 2026-08-26: sign up at https://pythdata.app/signup. Without it the
# site shows the last prints stored on chain (often old) and cannot settle
# rounds from the browser; it says so instead of failing.
PYTH_API_KEY=
HERMES_URL=https://hermes.pyth.network

# --- optional
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=

# --- development only: 1 = the site talks to MockPyth on a local Hardhat node
# (see README, "Playing a round locally"). Ignored on chain 4663.
NEXT_PUBLIC_PYTH_MOCK=
